# Default ignored files
/shelf/
/workspace.xml
# Editor-based HTTP Client requests
/httpRequests/
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml
# 💻 IDE 관련 설정 파일 (JetBrains/WebStorm, VSCode 등)
.idea/
.vscode/
*.iml

# 📦 Node.js 패키지 관리 관련
node_modules/
package-lock.json
yarn.lock

# 🛠️ 빌드/배포 관련 폴더
dist/
build/

# 🔧 환경 변수 파일 (보안 중요)
.env
.env.local
.env.production
.env.development

# ⚙️ 로그 파일
npm-debug.log
yarn-debug.log
yarn-error.log
*.log

# 📸 OS별 불필요한 파일
.DS_Store  # macOS
Thumbs.db  # Windows

